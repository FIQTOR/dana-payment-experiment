# ============================================================
# DANA Business API — Environment Configuration (EXPERIMENTAL)
# ============================================================
# Docs: https://dashboard.dana.id/api-docs-v2/
# These are sandbox/placeholder values. NEVER commit real secrets.
# ============================================================

# ---- Server ----
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# ---- DANA Business API credentials ----
# Your merchant/client identifier issued by DANA
DANA_PARTNER_ID=YOUR_PARTNER_ID
# Private key used as X-PARTNER-ID credential (client ID)
DANA_CLIENT_ID=YOUR_CLIENT_ID
# Client secret used to sign the access-token request (HMAC-SHA512).
# Issued by DANA alongside your client id.
DANA_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Base URLs for DANA Open API (SNAP)
# Sandbox:  https://api-sandbox.dana.id
# Prod:     https://api.dana.id
DANA_BASE_URL=https://api-sandbox.dana.id

# Merchant-level identifiers
DANA_MERCHANT_ID=YOUR_MERCHANT_ID
DANA_STORE_ID=YOUR_STORE_ID

# Terminal ID sent to DANA for each request
DANA_TERMINAL_ID=TERMINAL-01
# CHANNEL-ID header (varies per integration; provided by DANA)
DANA_CHANNEL_ID=95221

# ---- Keys ----
# Path to the RSA private key (PEM, PKCS#8) used to sign requests (X-SIGNATURE).
# `npm run gen-key` writes this to ./certs/private_key.pem
DANA_PRIVATE_KEY_PATH=./certs/private_key.pem
# Path to DANA's public key, used to verify webhook/callback signatures.
# NOTE: this is DANA's key (downloaded from the DANA dashboard), NOT the public
# key you generate. Leave empty/unset to skip verification in local dev.
# `npm run gen-key` also writes YOUR public key to ./certs/public_key.pem —
# that one is uploaded to the DANA dashboard, it is not used here.
DANA_PUBLIC_KEY_PATH=./certs/dana_public_key.pem

# ---- Webhook / callback ----
# Secret used to validate inbound webhook signatures (if using symmetric HMAC).
DANA_WEBHOOK_SECRET=change_me_webhook_secret

# Public URL where DANA should send async payment notifications
PUBLIC_BASE_URL=http://localhost:4000

# ---- Experiment flags ----
# When true, all outbound DANA calls are simulated locally (no network).
# Great for UI/flow experimentation without live sandbox credentials.
DANA_MOCK_MODE=true
